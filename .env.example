# API and shell
VITE_API_URL=http://localhost:8080
VITE_ORIGIN=http://localhost:3000

# Remote ports (used by pnpm dev and scripts/mf-types.mjs)
SELLER_PORT=3000
PRODUCT_PORT=3001
INVENTORY_PORT=3002
ACCOUNT_PORT=3004
PRICING_PORT=3005

# Module Federation type artifacts. Point at either @mf-types.d.ts or
# @mf-types.zip; the matching archive/API URL is derived automatically.
# Required when MF_DTS is enabled outside development. Defaults exist for
# `vite dev` only.
MF_ACCOUNT_TYPES_URL=http://localhost:3004/@mf-types.d.ts
MF_PRODUCT_TYPES_URL=http://localhost:3001/@mf-types.d.ts
MF_INVENTORY_TYPES_URL=http://localhost:3002/@mf-types.d.ts
MF_PRICING_TYPES_URL=http://localhost:3005/@mf-types.d.ts
